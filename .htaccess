# Enable RewriteEngine
RewriteEngine On

# Force ads.txt to be served as plain text
<Files "ads.txt">
    ForceType text/plain
    Header set Content-Type "text/plain"
</Files>

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove www (if it exists)
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Redirect index.html to root
RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Block access to CGI directories
RewriteRule ^cgi-bin/ - [F,L]
RewriteRule ^cgi-sys/ - [F,L]

# Redirect legacy/non-existent URLs to appropriate pages
RewriteRule ^state/north-carolina/$ /collections.html [R=301,L]
RewriteRule ^dog-parks-by-state/$ /collections.html [R=301,L]
